# Copy to .env and edit as needed. All values have sensible defaults.

# Where ollama is listening
OLLAMA_URL=http://localhost:11434

# Default model used when a request/agent does not specify one
DEFAULT_MODEL=gemma4:e2b-it-q4_K_M

# Embedding model used for agent long-term (semantic) memory
EMBED_MODEL=nomic-embed-text

# SQLite database file (agents, conversations, memories)
DB_PATH=./data/llmmock.db

# Default context window passed to ollama (num_ctx). Gemma 4 supports up to 131072,
# but a smaller window stays fast and uses less VRAM.
DEFAULT_NUM_CTX=8192

# Default sampling temperature
DEFAULT_TEMPERATURE=0.7

# How many semantic memories to retrieve and inject per agent turn
MEMORY_TOP_K=5
# Minimum cosine similarity for a memory to be considered relevant (0-1)
MEMORY_MIN_SCORE=0.35

# Server bind
HOST=0.0.0.0
PORT=8080

# Optional HTTPS/TLS. Set both to serve over https (run.sh passes them to uvicorn).
# Generate a self-signed cert for LAN/dev:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 \
#     -subj "/CN=YOUR_SERVER_IP" -addext "subjectAltName=IP:YOUR_SERVER_IP"
# SSL_CERTFILE=./cert.pem
# SSL_KEYFILE=./key.pem

# Optional API key. If set, clients must send "Authorization: Bearer <key>".
# Leave empty to disable auth (fine for local dev).
API_KEY=
